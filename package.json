    "build": "pnpm run clean && tsc && tsc-alias",
    "clean": "rm -rf dist",
    "prisma:start": "npx prisma generate",
    "start": "node dist/server.js",
    "start:dev": "nodemon dist/server.js",
    "dev:tamp": "pnpm run start:dev",
    "lint": "eslint . --ext .js,.ts --fix",
    "lint:check": "eslint . --ext .js,.ts",
    "prisma:seed": "ts-node prisma/seed.ts",
    "dev": "nodemon --verbose --watch src --ext ts --ignore ./dist --exec ts-node --transpile-only -r tsconfig-paths/register src/server.ts",
    "dev-local": "pnpm run build && pnpm run start:dev",
    "postinstall": "npx prisma generate",
    "format": "prettier --config .prettierrc --write \"src/**/*.{ts,tsx,js,jsx,json,md,css,scss,html}\""
  },
